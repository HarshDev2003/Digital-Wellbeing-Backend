# Digital Wellbeing - Sample Environment Variables
# Copy to .env and replace with local secrets

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/digital_wellbeing

# Security & JWT
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# External AI Provider
GEMINI_API_KEY=your_gemini_api_key_here

# Application
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
