# Digital Wellbeing - Sample Environment Variables
# Copy to .env and replace with local or Supabase secrets

# Database (PostgreSQL / Supabase)
# Option 1: Supabase Direct Connection (Session mode, Port 5432)
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Option 2: Supabase Connection Pooler (Transaction mode, Port 6543)
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Option 3: Local PostgreSQL (Default)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/digital_wellbeing

# Supabase Project Credentials (Found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Security & JWT
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# External AI Provider
GEMINI_API_KEY=your_gemini_api_key_here

# Application
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
