# ==============================================================================
# Digital Wellbeing - Comprehensive .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Python & FastAPI Backend
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Packaging & Distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/

# Type Checking & Linting
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ------------------------------------------------------------------------------
# Separately Implemented Client Repositories
# ------------------------------------------------------------------------------
mobile/
frontend/

# ------------------------------------------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
*.jks
secrets/
credentials.json

# ------------------------------------------------------------------------------
# Databases & Local Storage
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.rdb

# ------------------------------------------------------------------------------
# Node.js, Next.js & TypeScript (Web Dashboard)
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Next.js build output
.next/
out/

# TypeScript cache
*.tsbuildinfo
next-env.d.ts.bak

# ------------------------------------------------------------------------------
# Flutter & Dart (Mobile Companion)
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/

# Android build outputs
android/.gradle/
android/captures/
android/gradlew
android/gradlew.bat
android/local.properties
android/**/build/

# iOS build outputs
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/app.flx
ios/Flutter/app.zip
ios/Flutter/flutter_assets/
ios/ServiceDefinitions.json
ios/Runner/GeneratedPluginRegistrant.*

# ------------------------------------------------------------------------------
# Spec Kit & Machine-Local State
# ------------------------------------------------------------------------------
.specify/feature.json
.specify/integrations/packages/
.specify/integrations/packages.json
.specify/extensions/*/local-config.yml

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
logs/
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo

# ------------------------------------------------------------------------------
# OS-Specific Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~

# ------------------------------------------------------------------------------
# IDE & Editor Configurations
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace
